{
  "name": "vbt-hackathon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint",
    "build:static": "STATIC_EXPORT=1 NEXT_PUBLIC_BASE_PATH=/Hackathon2026 next build",
    "predeploy": "npm run build:static",
    "deploy": "gh-pages -d out --dotfiles",
    "api:install": "cd api && npm install",
    "api:dev": "cd api && npm run dev",
    "api:start": "cd api && npm run start"
  },
  "dependencies": {
    "@studio-freight/lenis": "^1.0.42",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.561.0",
    "next": "16.0.10",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.10.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  }
}
